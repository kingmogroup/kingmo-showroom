---
import MainLayout from '../layouts/MainLayout.astro';

// ✅ 把下面的 YOUR_ACCESS_KEY 换成你从 Web3Forms 收到的 Key
const WEB3FORMS_ACCESS_KEY = "5540153c-0bf9-4a8b-8ade-d142aae5755f";
---

<MainLayout title="Contact Us" activeCategory="CONTACT">
  <main class="max-w-[800px] mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <h1 class="text-3xl font-bold mb-2 text-center">Contact Us</h1>
    <p class="text-gray-500 text-center mb-10">
      Send us a message and we will get back to you within 24 hours.
    </p>

    <form
      action="https://api.web3forms.com/submit"
      method="POST"
      class="space-y-6"
    >
      <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
      <input type="hidden" name="from_name" value="Kingmo Showroom Contact Form" />
      <input type="hidden" name="subject" value="New Inquiry from Kingmo Showroom Website" />
      <input type="hidden" name="botcheck" />

      <!-- Name -->
      <div>
        <label class="block text-sm font-bold uppercase tracking-wider mb-2">Name</label>
        <input
          type="text"
          name="name"
          required
          class="w-full border border-gray-300 px-4 py-3 outline-none focus:border-black"
          placeholder="Your name"
        />
      </div>

      <!-- Email -->
      <div>
        <label class="block text-sm font-bold uppercase tracking-wider mb-2">Email</label>
        <input
          type="email"
          name="email"
          required
          class="w-full border border-gray-300 px-4 py-3 outline-none focus:border-black"
          placeholder="your@email.com"
        />
      </div>

      <!-- Phone / WhatsApp (可选) -->
      <div>
        <label class="block text-sm font-bold uppercase tracking-wider mb-2">Phone / WhatsApp (optional)</label>
        <input
          type="text"
          name="phone"
          class="w-full border border-gray-300 px-4 py-3 outline-none focus:border-black"
          placeholder="+86 ..."
        />
      </div>

      <!-- Message -->
      <div>
        <label class="block text-sm font-bold uppercase tracking-wider mb-2">Message</label>
        <textarea
          name="message"
          required
          rows="6"
          class="w-full border border-gray-300 px-4 py-3 outline-none focus:border-black"
          placeholder="Tell us about your inquiry... (product, quantity, logo, design...)"
        ></textarea>
      </div>

      <!-- 提交按钮 -->
      <button
        type="submit"
        class="w-full bg-black text-white text-sm font-bold tracking-wider py-4 uppercase hover:bg-gray-800 transition-colors"
      >
        Send Message
      </button>

      <!-- 提交结果提示 -->
      <div id="form-result" class="hidden text-center py-4"></div>
    </form>

    <!-- 底部联系信息 -->
    <div class="mt-12 pt-8 border-t border-gray-200 text-center text-sm text-gray-600 space-y-2">
      <p><strong>WhatsApp / WeChat:</strong> +86 137 9063 9935</p>
      <p><strong>Email us directly:</strong> kingmogroup@gmail.com</p>
      <p><strong>Business Hours:</strong> Monday - Saturday, 9:00 - 18:00 (GMT+8)</p>
    </div>

  </main>

  <script>
    const form = document.querySelector('form');
    const result = document.getElementById('form-result');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const button = form.querySelector('button[type="submit"]');
      button.textContent = 'Sending...';
      button.disabled = true;

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
        });
        const data = await response.json();

        if (data.success) {
          result.innerHTML = '<p class="text-green-600 font-bold">✓ Thank you! Your message has been sent. We will reply within 24 hours.</p>';
          form.reset();
        } else {
          result.innerHTML = '<p class="text-red-600 font-bold">✗ Something went wrong. Please try again or email us directly.</p>';
        }
      } catch (err) {
        result.innerHTML = '<p class="text-red-600 font-bold">✗ Network error. Please try again.</p>';
      }

      button.textContent = 'Send Message';
      button.disabled = false;
      result?.classList.remove('hidden');
    });
  </script>
</MainLayout>
